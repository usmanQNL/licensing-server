# Private signing keys. Never commit these.
keys/
root_private.pem
*_private.pem
private*.pem
private.pem
*.key
*.p8

# Deployment-specific key files. Public, but they belong to one deployment,
# not to this repo. Keep them next to the Dockerfile on your own machine.
*.pem
!verifiers/online-public.pem
!samples/demo/demo-public.pem
keys.json
keylist.json

# Settings and secrets
.env
gcp-sa.json

# Issued license files and license store exports
licenses/
license.json
*.license.json
# License cache files (<APP>_LICENSE_CACHE): fetched replies, install token, cached key list
*.cache.json
*.cache.json.tmp
license-data.json
dev-data.json

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Rust / Node / Dart build output
verifiers/rust/target/
samples/rust/target/
samples/rust/server/target/
samples/**/Cargo.lock
verifiers/rust/Cargo.lock
samples/node/package-lock.json
node_modules/
.dart_tool/
