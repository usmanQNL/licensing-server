# Copy this file to .env and fill it in. .env is gitignored, so your settings stay off git.
# Real environment variables override these values.

# --- Storage (pick one) ---
LICENSE_STORAGE=firestore
LICENSE_FIRESTORE_PROJECT=pigeonholes-license-server
# LICENSE_STORAGE=json
# LICENSE_JSON_PATH=dev-data.json


# Path to a service-account key file for Firestore. Keep the file outside the repo and mount it
# at run time (docker run -v). Cloud Run uses its own service account, so it doesn't need this.
# GOOGLE_APPLICATION_CREDENTIALS=/srv/gcp-sa.json

# --- Signing (used by the server, and by issue_license.py) ---
LICENSE_KID=k1
# Local server only. On Cloud Run, the key comes from Secret Manager.
LICENSE_SIGNING_KEY_PATH=private.pem

# --- Signed key list (GET /v1/keys) ---
LICENSE_KEYLIST_PATH=keylist.json

# --- Server limits ---
LICENSE_VALID_DAYS=7
LICENSE_RATE_LIMIT_PER_MIN=60
